# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องตัวเอง
# ⚠️ ห้าม commit ไฟล์ .env (อยู่ใน .gitignore แล้ว)

PORT=3000

# ---- ฐานข้อมูล: MySQL ในเครื่อง ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=adweb
DB_SSL=false

# ---- ฐานข้อมูล: TiDB Cloud Starter (ลบ # ออกแล้วใส่ค่าจากปุ่ม Connect) ----
# DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=xxxxxxxxxxxx.root
# DB_PASSWORD=รหัสจากปุ่ม Generate Password
# DB_NAME=adweb
# DB_SSL=true

# ใช้เฉพาะผู้ให้บริการที่ใช้ CA ของตัวเอง (เช่น aiven): วาง "เนื้อหา" ไฟล์ ca.pem ทั้งไฟล์ (ไม่ใช่ path)
# TiDB ไม่ต้องใส่ เว้นว่างไว้ (ใบรับรองที่ TiDB ใช้แนบไว้ใน lib/ca.ts แล้ว)
DB_SSL_CA=

# ---- CORS ----
# origin ของ frontend ที่อนุญาต คั่นด้วยจุลภาค, ใส่ * เพื่ออนุญาตทุกที่
CORS_ORIGINS=http://localhost:4200
